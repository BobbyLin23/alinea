#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$repo_root"

echo "Preparing Bun toolchain"
SECONDS=0
missing_packages=()
command -v curl >/dev/null || missing_packages+=(curl)
command -v unzip >/dev/null || missing_packages+=(unzip)
if ((${#missing_packages[@]})); then
  sudo apt-get update
  sudo apt-get install -y "${missing_packages[@]}"
fi

export BUN_INSTALL="$HOME/.bun"
export PATH="$BUN_INSTALL/bin:$PATH"
bun_version="$(node -p 'require("./package.json").packageManager.split("@")[1]')"
if ! command -v bun >/dev/null || [[ "$(bun --version)" != "$bun_version" ]]; then
  curl -fsSL https://bun.sh/install | bash -s -- "bun-v$bun_version"
fi

# Amp and supervised services start in separate login shells.
profile_marker="# alinea orb Bun toolchain"
if ! grep -Fqx "$profile_marker" "$HOME/.bash_profile" 2>/dev/null; then
  cat >> "$HOME/.bash_profile" <<'EOF'

# alinea orb Bun toolchain
export BUN_INSTALL="$HOME/.bun"
case ":$PATH:" in
  *":$BUN_INSTALL/bin:"*) ;;
  *) export PATH="$BUN_INSTALL/bin:$PATH" ;;
esac
EOF
fi
echo "Bun $(bun --version) ready (${SECONDS}s)"

# These are local, non-secret defaults; preserve any existing configuration.
[[ -f apps/web/.env.local ]] || printf 'VITE_SERVER_URL=http://localhost:3000\n' > apps/web/.env.local
[[ -f apps/server/.env.local ]] || printf 'CORS_ORIGIN=http://localhost:3001\n' > apps/server/.env.local

echo "Installing locked workspace dependencies and generating env types"
SECONDS=0
bun install --frozen-lockfile
echo "Dependencies ready (${SECONDS}s)"
